// ============================================================================
// APEX PRECISION TRADER — BATCH 6 APPEND BLOCK
// VISUAL CONSOLIDATION & UX
// Paste this complete block at the END of the file after Batch 5.
// Do not delete or replace earlier batches.
// ============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// B6.1 INPUTS
// ─────────────────────────────────────────────────────────────────────────────
groupB6Display = "Batch 6 — Visual Consolidation"

b6UseUnifiedDashboard = input.bool(
     true,
     "Use unified Apex dashboard",
     group=groupB6Display
)

b6CompactMode = input.bool(
     true,
     "Compact dashboard mode",
     group=groupB6Display
)

b6ShowEvidenceRows = input.bool(
     false,
     "Show evidence rows",
     group=groupB6Display
)

b6ShowOnlyBestSetup = input.bool(
     true,
     "Show only best active setup",
     group=groupB6Display
)

b6ShowNoTradeReason = input.bool(
     true,
     "Show no-trade reason",
     group=groupB6Display
)

b6ShowSignalBadge = input.bool(
     true,
     "Show signal badge",
     group=groupB6Display
)

b6ShowProjectedLabels = input.bool(
     true,
     "Show entry / SL / TP labels",
     group=groupB6Display
)

b6FadeInactiveGeometry = input.bool(
     true,
     "Fade invalid or expired geometry",
     group=groupB6Display
)

b6DashboardPosition = input.string(
     "Top Right",
     "Dashboard position",
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"],
     group=groupB6Display
)

// ─────────────────────────────────────────────────────────────────────────────
// B6.2 DISPLAY HELPERS
// ─────────────────────────────────────────────────────────────────────────────
f_b6_position(string selectedPosition) =>
    selectedPosition == "Top Left" ? position.top_left :
     selectedPosition == "Bottom Right" ? position.bottom_right :
     selectedPosition == "Bottom Left" ? position.bottom_left :
     position.top_right

f_b6_price(float value) =>
    na(value) ? "—" : str.tostring(value, format.mintick)

f_b6_quality(float value) =>
    na(value) ? "—" : str.tostring(math.round(value)) + "/100"

f_b6_rr(float value) =>
    na(value) ? "—" : str.tostring(value, "#.##") + "R"

f_b6_direction_text() =>
    b4SetupDirection == 1 ? "LONG" :
     b4SetupDirection == -1 ? "SHORT" :
     "NONE"

f_b6_direction_colour() =>
    b4SetupDirection == 1 ? bullColor :
     b4SetupDirection == -1 ? bearColor :
     neutralColor

f_b6_no_trade_reason() =>
    string reason =
         marketState == "CHAOTIC" ? "CHAOTIC MARKET" :
         b3DirectionConflict ? "LONG / SHORT CONFLICT" :
         not b3LongRaw and not b3ShortRaw ? "NO VALID STRATEGY" :
         b3LongRaw and not b3LongValid and
         b3ShortRaw and not b3ShortValid ? "QUALITY / HTF FILTER" :
         not b4SetupActive ? "NO ACTIVE SETUP" :
         b4SetupInvalidated ? "SETUP INVALIDATED" :
         b4SetupExpired ? "SETUP EXPIRED" :
         not b5StopValid ? "STOP INVALID" :
         not b5TargetValid ? "TARGET OR R:R INVALID" :
         "NO EXECUTABLE ENTRY"
    reason

string b6DirectionText = f_b6_direction_text()
color b6DirectionColour = f_b6_direction_colour()
string b6NoTradeReason = f_b6_no_trade_reason()

bool b6ExecutableNow =
     b4SetupActive and
     b5GeometryValid and
     (
         b4LifecycleState == "READY NOW" or
         b4LifecycleState == "TRIGGERED" or
         b4LifecycleState == "REENTRY AVAILABLE"
     )

bool b6FutureSetup =
     b4SetupActive and
     b5GeometryValid and
     (
         b4LifecycleState == "APPROACHING ENTRY" or
         b4LifecycleState == "CONFIRMATION" or
         b4LifecycleState == "PULLBACK / RETEST PENDING"
     )

string b6PrimaryStatus =
     b6ExecutableNow ? "EXECUTABLE" :
     b6FutureSetup ? "FUTURE SETUP" :
     b4SetupMissed ? "MISSED ENTRY" :
     b4SetupInvalidated ? "INVALIDATED" :
     b4SetupExpired ? "EXPIRED" :
     "NO TRADE"

color b6PrimaryColour =
     b6ExecutableNow ? b6DirectionColour :
     b6FutureSetup ? transitionColor :
     b4SetupMissed ? compressionColor :
     neutralColor

// ─────────────────────────────────────────────────────────────────────────────
// B6.3 HIDE LEGACY PANELS WHEN UNIFIED MODE IS ENABLED
// Earlier panel code remains intact, but these blocks clear them on the last bar.
// ─────────────────────────────────────────────────────────────────────────────
if barstate.islast and b6UseUnifiedDashboard
    table.clear(dashboard, 0, 0, 1, 12)
    table.clear(b2StructurePanel, 0, 0, 1, 6)
    table.clear(b3CandidatePanel, 0, 0, 1, 8)
    table.clear(b4LifecyclePanel, 0, 0, 1, 9)
    table.clear(b5GeometryPanel, 0, 0, 1, 11)

// ─────────────────────────────────────────────────────────────────────────────
// B6.4 UNIFIED DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────
var table b6UnifiedDashboard = table.new(
     f_b6_position(b6DashboardPosition),
     2,
     18,
     border_width=1,
     frame_color=color.new(color.white, 78),
     border_color=color.new(color.white, 84)
)

if barstate.islast and b6UseUnifiedDashboard
    table.clear(b6UnifiedDashboard, 0, 0, 1, 17)

    table.cell(
         b6UnifiedDashboard,
         0,
         0,
         "APEX PRECISION",
         text_color=color.white,
         bgcolor=color.new(b6PrimaryColour, 25),
         text_size=size.small
    )

    table.cell(
         b6UnifiedDashboard,
         1,
         0,
         b6PrimaryStatus,
         text_color=color.white,
         bgcolor=color.new(b6PrimaryColour, 25),
         text_size=size.small
    )

    f_cell(
         b6UnifiedDashboard,
         1,
         "Direction",
         b6DirectionText,
         b6DirectionColour
    )

    f_cell(
         b6UnifiedDashboard,
         2,
         "Strategy",
         b4SetupActive ? b4SetupStrategy : "NONE",
         color.white
    )

    f_cell(
         b6UnifiedDashboard,
         3,
         "Lifecycle",
         b4LifecycleState,
         b4LifecycleColour
    )

    f_cell(
         b6UnifiedDashboard,
         4,
         "Market state",
         marketState,
         stateColour
    )

    f_cell(
         b6UnifiedDashboard,
         5,
         "Context",
         contextAgreement,
         contextColour
    )

    f_cell(
         b6UnifiedDashboard,
         6,
         "Structure",
         b2SwingStructure,
         b2StructureColour
    )

    f_cell(
         b6UnifiedDashboard,
         7,
         "Entry",
         f_b6_price(b4SetupIdealEntry),
         compressionColor
    )

    f_cell(
         b6UnifiedDashboard,
         8,
         "Entry range",
         na(b4SetupEntryLow) or na(b4SetupEntryHigh) ?
         "—" :
         f_b6_price(b4SetupEntryLow) + " - " + f_b6_price(b4SetupEntryHigh),
         compressionColor
    )

    f_cell(
         b6UnifiedDashboard,
         9,
         "Stop",
         f_b6_price(b5StopPrice),
         bearColor
    )

    f_cell(
         b6UnifiedDashboard,
         10,
         "TP1",
         f_b6_price(b5Tp1),
         bullColor
    )

    f_cell(
         b6UnifiedDashboard,
         11,
         "TP2",
         f_b6_price(b5Tp2),
         bullColor
    )

    f_cell(
         b6UnifiedDashboard,
         12,
         "TP3",
         b5RunnerAllowed ? f_b6_price(b5DisplayedTp3) : "DISABLED",
         b5RunnerAllowed ? bullColor : neutralColor
    )

    f_cell(
         b6UnifiedDashboard,
         13,
         "Net R:R",
         f_b6_rr(b5NetRR1),
         b5TargetValid ? bullColor : compressionColor
    )

    f_cell(
         b6UnifiedDashboard,
         14,
         "Quality",
         f_b6_quality(b4SetupQuality),
         b6DirectionColour
    )

    f_cell(
         b6UnifiedDashboard,
         15,
         "HTF conflict",
         b4SetupActive ? f_b3_conflict_text(b4SetupConflict) : "—",
         b4SetupConflict >= 3 ?
         bearColor :
         b4SetupConflict >= 1 ?
         compressionColor :
         bullColor
    )

    if not b6CompactMode
        f_cell(
             b6UnifiedDashboard,
             16,
             "Maximum chase",
             f_b6_price(b4SetupMaximumChase),
             compressionColor
        )

        f_cell(
             b6UnifiedDashboard,
             17,
             "Pre-invalidation",
             f_b6_price(b4SetupPreInvalidation),
             bearColor
        )
    else
        string compactReason =
             b6PrimaryStatus == "NO TRADE" and b6ShowNoTradeReason ?
             b6NoTradeReason :
             b4SetupActive ?
             "AGE " + str.tostring(b4SetupAge) + " BARS" :
             b6NoTradeReason

        f_cell(
             b6UnifiedDashboard,
             16,
             "Status detail",
             compactReason,
             b6PrimaryColour
        )

        f_cell(
             b6UnifiedDashboard,
             17,
             "Role",
             role + " | " + setupTf + " / " + macroTf,
             color.white
        )

if barstate.islast and not b6UseUnifiedDashboard
    table.clear(b6UnifiedDashboard, 0, 0, 1, 17)

// ─────────────────────────────────────────────────────────────────────────────
// B6.5 EVIDENCE PANEL
// Optional advanced diagnostic panel.
// ─────────────────────────────────────────────────────────────────────────────
var table b6EvidencePanel = table.new(
     position.top_center,
     2,
     8,
     border_width=1,
     frame_color=color.new(color.white, 82),
     border_color=color.new(color.white, 88)
)

if barstate.islast and b6ShowEvidenceRows
    table.clear(b6EvidencePanel, 0, 0, 1, 7)

    table.cell(
         b6EvidencePanel,
         0,
         0,
         "APEX EVIDENCE",
         text_color=color.white,
         bgcolor=color.new(neutralColor, 35),
         text_size=size.small
    )

    table.cell(
         b6EvidencePanel,
         1,
         0,
         "LIVE",
         text_color=color.white,
         bgcolor=color.new(neutralColor, 35),
         text_size=size.small
    )

    f_cell(
         b6EvidencePanel,
         1,
         "Local trend",
         f_trend_text(localTrend),
         f_trend_colour(localTrend)
    )

    f_cell(
         b6EvidencePanel,
         2,
         "Setup trend",
         f_trend_text(setupTrend),
         f_trend_colour(setupTrend)
    )

    f_cell(
         b6EvidencePanel,
         3,
         "Macro trend",
         f_trend_text(macroTrend),
         f_trend_colour(macroTrend)
    )

    f_cell(
         b6EvidencePanel,
         4,
         "Relative volume",
         str.tostring(relativeVolume, "#.##"),
         color.white
    )

    f_cell(
         b6EvidencePanel,
         5,
         "RSI",
         str.tostring(roleRsi, "#.0"),
         color.white
    )

    f_cell(
         b6EvidencePanel,
         6,
         "Efficiency",
         str.tostring(efficiency, "#.###"),
         color.white
    )

    f_cell(
         b6EvidencePanel,
         7,
         "Channel position",
         str.tostring(channelPosition * 100.0, "#.0") + "%",
         color.white
    )

if barstate.islast and not b6ShowEvidenceRows
    table.clear(b6EvidencePanel, 0, 0, 1, 7)

// ─────────────────────────────────────────────────────────────────────────────
// B6.6 PROJECTED PRICE LABELS
// ─────────────────────────────────────────────────────────────────────────────
var label b6EntryLabel = na
var label b6StopLabel = na
var label b6Tp1Label = na
var label b6Tp2Label = na
var label b6Tp3Label = na

if barstate.islast
    label.delete(b6EntryLabel)
    label.delete(b6StopLabel)
    label.delete(b6Tp1Label)
    label.delete(b6Tp2Label)
    label.delete(b6Tp3Label)

    if b6ShowProjectedLabels and b4SetupActive
        b6EntryLabel := label.new(
             x=bar_index + b5ProjectionBars,
             y=b4SetupIdealEntry,
             text="ENTRY " + f_b6_price(b4SetupIdealEntry),
             style=label.style_label_left,
             color=color.new(compressionColor, 15),
             textcolor=color.white,
             size=size.tiny
        )

        if b5StopValid
            b6StopLabel := label.new(
                 x=bar_index + b5ProjectionBars,
                 y=b5StopPrice,
                 text="SL " + f_b6_price(b5StopPrice),
                 style=label.style_label_left,
                 color=color.new(bearColor, 10),
                 textcolor=color.white,
                 size=size.tiny
            )

        if b5TargetValid
            b6Tp1Label := label.new(
                 x=bar_index + b5ProjectionBars,
                 y=b5Tp1,
                 text="TP1 " + f_b6_price(b5Tp1),
                 style=label.style_label_left,
                 color=color.new(bullColor, 10),
                 textcolor=color.white,
                 size=size.tiny
            )

            b6Tp2Label := label.new(
                 x=bar_index + b5ProjectionBars,
                 y=b5Tp2,
                 text="TP2 " + f_b6_price(b5Tp2),
                 style=label.style_label_left,
                 color=color.new(bullColor, 25),
                 textcolor=color.white,
                 size=size.tiny
            )

            if b5RunnerAllowed
                b6Tp3Label := label.new(
                     x=bar_index + b5ProjectionBars,
                     y=b5DisplayedTp3,
                     text="TP3 " + f_b6_price(b5DisplayedTp3),
                     style=label.style_label_left,
                     color=color.new(bullColor, 40),
                     textcolor=color.white,
                     size=size.tiny
                )

// ─────────────────────────────────────────────────────────────────────────────
// B6.7 SIGNAL BADGE
// ─────────────────────────────────────────────────────────────────────────────
var label b6SignalBadge = na

if barstate.islast
    label.delete(b6SignalBadge)

    if b6ShowSignalBadge
        string badgeText =
             b6ExecutableNow ?
             "APEX " + b6DirectionText + "\n" + b4SetupStrategy + "\nREADY" :
             b6FutureSetup ?
             "APEX " + b6DirectionText + "\n" + b4SetupStrategy + "\n" + b4LifecycleState :
             b6ShowNoTradeReason ?
             "APEX NO TRADE\n" + b6NoTradeReason :
             ""

        if badgeText != ""
            float badgeY =
                 b4SetupDirection == 1 ?
                 low :
                 b4SetupDirection == -1 ?
                 high :
                 close

            b6SignalBadge := label.new(
                 x=bar_index,
                 y=badgeY,
                 text=badgeText,
                 style=b4SetupDirection == 1 ?
                 label.style_label_up :
                 b4SetupDirection == -1 ?
                 label.style_label_down :
                 label.style_label_left,
                 color=color.new(b6PrimaryColour, 10),
                 textcolor=color.white,
                 size=size.small
            )

// ─────────────────────────────────────────────────────────────────────────────
// B6.8 VISUAL FADING FOR INACTIVE SETUPS
// ─────────────────────────────────────────────────────────────────────────────
bool b6InactivePlan =
     b4SetupInvalidated or
     b4SetupExpired or
     not b5GeometryValid

color b6GeometryFadeColour =
     b6InactivePlan and b6FadeInactiveGeometry ?
     color.new(neutralColor, 70) :
     na

plot(
     b6InactivePlan and b6FadeInactiveGeometry and b4SetupActive ?
     b4SetupIdealEntry :
     na,
     "Inactive Setup Reference",
     color=b6GeometryFadeColour,
     linewidth=1,
     style=plot.style_linebr
)

// ============================================================================
// END OF BATCH 6 APPEND BLOCK
// ============================================================================


// ============================================================================
// APEX PRECISION TRADER — BATCH 7 APPEND BLOCK
// ALERTS, VALIDATION HOOKS, AND FINAL RUNTIME STATES
// Paste this complete block at the END of the file after Batch 6.
// Do not delete or replace earlier batches.
// ============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// B7.1 INPUTS
// ─────────────────────────────────────────────────────────────────────────────
groupB7Alerts = "Batch 7 — Alerts & Validation"

b7EnableReadyAlerts = input.bool(
     true,
     "Enable ready alerts",
     group=groupB7Alerts
)

b7EnableFutureAlerts = input.bool(
     true,
     "Enable approaching / future alerts",
     group=groupB7Alerts
)

b7EnableInvalidationAlerts = input.bool(
     true,
     "Enable invalidation alerts",
     group=groupB7Alerts
)

b7EnableOutcomeAlerts = input.bool(
     true,
     "Enable TP / SL alerts",
     group=groupB7Alerts
)

b7ShowValidationPanel = input.bool(
     false,
     "Show validation panel",
     group=groupB7Alerts
)

b7RequireStateChangeForAlert = input.bool(
     true,
     "Alert only on state change",
     group=groupB7Alerts
)

b7EnableHistoricalMarkers = input.bool(
     true,
     "Show historical signal markers",
     group=groupB7Alerts
)

// ─────────────────────────────────────────────────────────────────────────────
// B7.2 STATE TRANSITIONS
// ─────────────────────────────────────────────────────────────────────────────
string b7CurrentState =
     b6ExecutableNow ? "EXECUTABLE" :
     b6FutureSetup ? "FUTURE" :
     b4SetupMissed ? "MISSED" :
     b4SetupInvalidated ? "INVALIDATED" :
     b4SetupExpired ? "EXPIRED" :
     "NO_TRADE"

string b7PreviousState = nz(b7CurrentState[1], "NO_TRADE")

bool b7StateChanged =
     b7CurrentState != b7PreviousState

bool b7AlertGate =
     not b7RequireStateChangeForAlert or
     b7StateChanged

bool b7NewExecutableLong =
     b7EnableReadyAlerts and
     b7AlertGate and
     b6ExecutableNow and
     b4SetupDirection == 1 and
     barstate.isconfirmed

bool b7NewExecutableShort =
     b7EnableReadyAlerts and
     b7AlertGate and
     b6ExecutableNow and
     b4SetupDirection == -1 and
     barstate.isconfirmed

bool b7NewFutureLong =
     b7EnableFutureAlerts and
     b7AlertGate and
     b6FutureSetup and
     b4SetupDirection == 1 and
     barstate.isconfirmed

bool b7NewFutureShort =
     b7EnableFutureAlerts and
     b7AlertGate and
     b6FutureSetup and
     b4SetupDirection == -1 and
     barstate.isconfirmed

bool b7NewInvalidation =
     b7EnableInvalidationAlerts and
     b7AlertGate and
     b4SetupInvalidated and
     barstate.isconfirmed

bool b7NewExpiry =
     b7EnableInvalidationAlerts and
     b7AlertGate and
     b4SetupExpired and
     barstate.isconfirmed

bool b7NewMissedEntry =
     b7EnableFutureAlerts and
     b7AlertGate and
     b4SetupMissed and
     barstate.isconfirmed

bool b7NewReentry =
     b7EnableReadyAlerts and
     b7AlertGate and
     b4LifecycleState == "REENTRY AVAILABLE" and
     barstate.isconfirmed

// ─────────────────────────────────────────────────────────────────────────────
// B7.3 OUTCOME TRACKING
// Tracks only the currently active persistent setup.
// ─────────────────────────────────────────────────────────────────────────────
var bool b7OutcomeTrackingActive = false
var bool b7Tp1Hit = false
var bool b7Tp2Hit = false
var bool b7Tp3Hit = false
var bool b7StopHit = false
var int b7OutcomeSetupCreatedBar = na

bool b7NewTrackedSetup =
     b4SetupActive and
     b5GeometryValid and
     (
         na(b7OutcomeSetupCreatedBar) or
         b7OutcomeSetupCreatedBar != b4SetupCreatedBar
     )

if b7NewTrackedSetup
    b7OutcomeTrackingActive := true
    b7Tp1Hit := false
    b7Tp2Hit := false
    b7Tp3Hit := false
    b7StopHit := false
    b7OutcomeSetupCreatedBar := b4SetupCreatedBar

bool b7LongTp1Touch =
     b7OutcomeTrackingActive and
     b4SetupDirection == 1 and
     high >= b5Tp1

bool b7LongTp2Touch =
     b7OutcomeTrackingActive and
     b4SetupDirection == 1 and
     high >= b5Tp2

bool b7LongTp3Touch =
     b7OutcomeTrackingActive and
     b4SetupDirection == 1 and
     b5RunnerAllowed and
     high >= b5DisplayedTp3

bool b7LongStopTouch =
     b7OutcomeTrackingActive and
     b4SetupDirection == 1 and
     low <= b5StopPrice

bool b7ShortTp1Touch =
     b7OutcomeTrackingActive and
     b4SetupDirection == -1 and
     low <= b5Tp1

bool b7ShortTp2Touch =
     b7OutcomeTrackingActive and
     b4SetupDirection == -1 and
     low <= b5Tp2

bool b7ShortTp3Touch =
     b7OutcomeTrackingActive and
     b4SetupDirection == -1 and
     b5RunnerAllowed and
     low <= b5DisplayedTp3

bool b7ShortStopTouch =
     b7OutcomeTrackingActive and
     b4SetupDirection == -1 and
     high >= b5StopPrice

bool b7Tp1Touch =
     b7LongTp1Touch or
     b7ShortTp1Touch

bool b7Tp2Touch =
     b7LongTp2Touch or
     b7ShortTp2Touch

bool b7Tp3Touch =
     b7LongTp3Touch or
     b7ShortTp3Touch

bool b7StopTouch =
     b7LongStopTouch or
     b7ShortStopTouch

// Conservative same-bar ordering:
// if stop and target are both touched on the same candle, stop wins.
if b7OutcomeTrackingActive and not b7StopHit
    if b7StopTouch
        b7StopHit := true
        b7OutcomeTrackingActive := false
    else
        if b7Tp1Touch
            b7Tp1Hit := true

        if b7Tp2Touch
            b7Tp2Hit := true

        if b7Tp3Touch
            b7Tp3Hit := true
            b7OutcomeTrackingActive := false

bool b7NewTp1Hit =
     b7EnableOutcomeAlerts and
     b7Tp1Hit and
     not b7Tp1Hit[1] and
     barstate.isconfirmed

bool b7NewTp2Hit =
     b7EnableOutcomeAlerts and
     b7Tp2Hit and
     not b7Tp2Hit[1] and
     barstate.isconfirmed

bool b7NewTp3Hit =
     b7EnableOutcomeAlerts and
     b7Tp3Hit and
     not b7Tp3Hit[1] and
     barstate.isconfirmed

bool b7NewStopHit =
     b7EnableOutcomeAlerts and
     b7StopHit and
     not b7StopHit[1] and
     barstate.isconfirmed

// ─────────────────────────────────────────────────────────────────────────────
// B7.4 HISTORICAL MARKERS
// ─────────────────────────────────────────────────────────────────────────────
plotshape(
     b7EnableHistoricalMarkers and b7NewExecutableLong,
     title="APEX Long Ready",
     style=shape.triangleup,
     location=location.belowbar,
     color=bullColor,
     size=size.small,
     text="APEX L"
)

plotshape(
     b7EnableHistoricalMarkers and b7NewExecutableShort,
     title="APEX Short Ready",
     style=shape.triangledown,
     location=location.abovebar,
     color=bearColor,
     size=size.small,
     text="APEX S"
)

plotshape(
     b7EnableHistoricalMarkers and b7NewFutureLong,
     title="APEX Future Long",
     style=shape.circle,
     location=location.belowbar,
     color=color.new(transitionColor, 10),
     size=size.tiny,
     text="FL"
)

plotshape(
     b7EnableHistoricalMarkers and b7NewFutureShort,
     title="APEX Future Short",
     style=shape.circle,
     location=location.abovebar,
     color=color.new(transitionColor, 10),
     size=size.tiny,
     text="FS"
)

plotshape(
     b7EnableHistoricalMarkers and b7NewInvalidation,
     title="APEX Invalidated",
     style=shape.xcross,
     location=location.abovebar,
     color=neutralColor,
     size=size.tiny,
     text="X"
)

plotshape(
     b7EnableHistoricalMarkers and b7NewMissedEntry,
     title="APEX Missed Entry",
     style=shape.square,
     location=location.abovebar,
     color=compressionColor,
     size=size.tiny,
     text="MISS"
)

plotshape(
     b7EnableHistoricalMarkers and b7NewTp1Hit,
     title="APEX TP1 Hit",
     style=shape.circle,
     location=location.abovebar,
     color=bullColor,
     size=size.tiny,
     text="TP1"
)

plotshape(
     b7EnableHistoricalMarkers and b7NewStopHit,
     title="APEX Stop Hit",
     style=shape.xcross,
     location=location.belowbar,
     color=bearColor,
     size=size.tiny,
     text="SL"
)

// ─────────────────────────────────────────────────────────────────────────────
// B7.5 ALERT CONDITIONS
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(
     b7NewExecutableLong,
     "APEX LONG READY",
     "APEX LONG READY | {{ticker}} | TF {{interval}} | Closed-candle confirmed"
)

alertcondition(
     b7NewExecutableShort,
     "APEX SHORT READY",
     "APEX SHORT READY | {{ticker}} | TF {{interval}} | Closed-candle confirmed"
)

alertcondition(
     b7NewFutureLong,
     "APEX FUTURE LONG",
     "APEX FUTURE LONG | {{ticker}} | TF {{interval}} | Entry not ready"
)

alertcondition(
     b7NewFutureShort,
     "APEX FUTURE SHORT",
     "APEX FUTURE SHORT | {{ticker}} | TF {{interval}} | Entry not ready"
)

alertcondition(
     b7NewReentry,
     "APEX REENTRY AVAILABLE",
     "APEX REENTRY AVAILABLE | {{ticker}} | TF {{interval}}"
)

alertcondition(
     b7NewMissedEntry,
     "APEX ENTRY MISSED",
     "APEX ENTRY MISSED | {{ticker}} | TF {{interval}}"
)

alertcondition(
     b7NewInvalidation,
     "APEX SETUP INVALIDATED",
     "APEX SETUP INVALIDATED | {{ticker}} | TF {{interval}}"
)

alertcondition(
     b7NewExpiry,
     "APEX SETUP EXPIRED",
     "APEX SETUP EXPIRED | {{ticker}} | TF {{interval}}"
)

alertcondition(
     b7NewTp1Hit,
     "APEX TP1 HIT",
     "APEX TP1 HIT | {{ticker}} | TF {{interval}}"
)

alertcondition(
     b7NewTp2Hit,
     "APEX TP2 HIT",
     "APEX TP2 HIT | {{ticker}} | TF {{interval}}"
)

alertcondition(
     b7NewTp3Hit,
     "APEX TP3 HIT",
     "APEX TP3 HIT | {{ticker}} | TF {{interval}}"
)

alertcondition(
     b7NewStopHit,
     "APEX STOP HIT",
     "APEX STOP HIT | {{ticker}} | TF {{interval}}"
)

// ─────────────────────────────────────────────────────────────────────────────
// B7.6 VALIDATION FLAGS
// These are runtime consistency checks, not trading signals.
// ─────────────────────────────────────────────────────────────────────────────
bool b7EntryRangeValid =
     not b4SetupActive or
     (
         not na(b4SetupEntryLow) and
         not na(b4SetupEntryHigh) and
         b4SetupEntryLow <= b4SetupEntryHigh
     )

bool b7StopCorrectSide =
     not b4SetupActive or
     (
         b4SetupDirection == 1 ?
         b5StopPrice < b4SetupIdealEntry :
         b4SetupDirection == -1 ?
         b5StopPrice > b4SetupIdealEntry :
         true
     )

bool b7Tp1CorrectSideCheck =
     not b4SetupActive or
     (
         b4SetupDirection == 1 ?
         b5Tp1 > b4SetupIdealEntry :
         b4SetupDirection == -1 ?
         b5Tp1 < b4SetupIdealEntry :
         true
     )

bool b7NoCriticalConflictExecutable =
     not b6ExecutableNow or
     b4SetupConflict < 4

bool b7ClosedBarExecutable =
     not b6ExecutableNow or
     barstate.isconfirmed

bool b7ValidationPassed =
     b7EntryRangeValid and
     b7StopCorrectSide and
     b7Tp1CorrectSideCheck and
     b7NoCriticalConflictExecutable and
     b7ClosedBarExecutable

string b7ValidationState =
     b7ValidationPassed ? "PASS" :
     not b7EntryRangeValid ? "ENTRY RANGE ERROR" :
     not b7StopCorrectSide ? "STOP SIDE ERROR" :
     not b7Tp1CorrectSideCheck ? "TP SIDE ERROR" :
     not b7NoCriticalConflictExecutable ? "HTF CONFLICT ERROR" :
     not b7ClosedBarExecutable ? "OPEN BAR ERROR" :
     "UNKNOWN ERROR"

color b7ValidationColour =
     b7ValidationPassed ?
     bullColor :
     bearColor

// ─────────────────────────────────────────────────────────────────────────────
// B7.7 VALIDATION PANEL
// ─────────────────────────────────────────────────────────────────────────────
var table b7ValidationPanel = table.new(
     position.bottom_center,
     2,
     8,
     border_width=1,
     frame_color=color.new(color.white, 82),
     border_color=color.new(color.white, 88)
)

if barstate.islast and b7ShowValidationPanel
    table.clear(b7ValidationPanel, 0, 0, 1, 7)

    table.cell(
         b7ValidationPanel,
         0,
         0,
         "APEX VALIDATION",
         text_color=color.white,
         bgcolor=color.new(b7ValidationColour, 30),
         text_size=size.small
    )

    table.cell(
         b7ValidationPanel,
         1,
         0,
         b7ValidationState,
         text_color=color.white,
         bgcolor=color.new(b7ValidationColour, 30),
         text_size=size.small
    )

    f_cell(
         b7ValidationPanel,
         1,
         "Entry range",
         b7EntryRangeValid ? "PASS" : "FAIL",
         b7EntryRangeValid ? bullColor : bearColor
    )

    f_cell(
         b7ValidationPanel,
         2,
         "Stop side",
         b7StopCorrectSide ? "PASS" : "FAIL",
         b7StopCorrectSide ? bullColor : bearColor
    )

    f_cell(
         b7ValidationPanel,
         3,
         "TP1 side",
         b7Tp1CorrectSideCheck ? "PASS" : "FAIL",
         b7Tp1CorrectSideCheck ? bullColor : bearColor
    )

    f_cell(
         b7ValidationPanel,
         4,
         "Critical HTF",
         b7NoCriticalConflictExecutable ? "PASS" : "FAIL",
         b7NoCriticalConflictExecutable ? bullColor : bearColor
    )

    f_cell(
         b7ValidationPanel,
         5,
         "Closed bar",
         b7ClosedBarExecutable ? "PASS" : "FAIL",
         b7ClosedBarExecutable ? bullColor : bearColor
    )

    f_cell(
         b7ValidationPanel,
         6,
         "Tracked TP1",
         b7Tp1Hit ? "HIT" : "PENDING",
         b7Tp1Hit ? bullColor : neutralColor
    )

    f_cell(
         b7ValidationPanel,
         7,
         "Tracked stop",
         b7StopHit ? "HIT" : "PENDING",
         b7StopHit ? bearColor : neutralColor
    )

if barstate.islast and not b7ShowValidationPanel
    table.clear(b7ValidationPanel, 0, 0, 1, 7)

// ============================================================================
// END OF BATCH 7 APPEND BLOCK
// ============================================================================