//@version=6
indicator("Apex Precision Trader v0.1", shorttitle="APEX-TV", overlay=true, max_lines_count=100, max_labels_count=100, max_boxes_count=30)

// TradingView approximation of selected Apex concepts.
// This is not the Python Apex canonical analysis authority.

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
generalGroup = "General"
mode = input.string("Auto", "Trading mode", options=["Auto", "Scalp", "Intraday", "Swing"], group=generalGroup)
strictness = input.string("Balanced", "Strictness", options=["Conservative", "Balanced", "Aggressive"], group=generalGroup)
confirmOnClose = input.bool(true, "Closed-candle signals only", group=generalGroup)
showDashboard = input.bool(true, "Show dashboard", group=generalGroup)
showGeometry = input.bool(true, "Show active trade geometry", group=generalGroup)
showRegimeBackground = input.bool(false, "Show subtle regime background", group=generalGroup)
showDebug = input.bool(false, "Show evidence rows", group=generalGroup)

geometryGroup = "Geometry"
swingLookback = input.int(12, "Swing lookback", minval=5, maxval=100, group=geometryGroup)
structureLookback = input.int(40, "Structure lookback", minval=15, maxval=250, group=geometryGroup)
stopAtrBuffer = input.float(0.25, "Stop ATR buffer", minval=0.05, maxval=2.0, step=0.05, group=geometryGroup)
minimumTp1RR = input.float(1.15, "Minimum TP1 R:R", minval=0.5, maxval=5.0, step=0.05, group=geometryGroup)
maximumChaseAtr = input.float(0.45, "Maximum chase (ATR)", minval=0.1, maxval=2.0, step=0.05, group=geometryGroup)
tp2Multiple = input.float(2.0, "TP2 R multiple", minval=1.0, maxval=6.0, step=0.25, group=geometryGroup)
tp3Multiple = input.float(3.0, "TP3 R multiple", minval=1.5, maxval=10.0, step=0.25, group=geometryGroup)

colourGroup = "Colours"
longColour = input.color(color.rgb(0, 190, 120), "Long", group=colourGroup)
shortColour = input.color(color.rgb(235, 70, 80), "Short", group=colourGroup)
entryColour = input.color(color.rgb(245, 190, 55), "Entry", group=colourGroup)
neutralColour = input.color(color.rgb(150, 155, 165), "Neutral", group=colourGroup)

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────
f_safe_div(float numerator, float denominator) =>
    denominator == 0.0 ? 0.0 : numerator / denominator

f_clamp(float value, float low, float high) =>
    math.max(low, math.min(high, value))

f_role() =>
    float seconds = timeframe.in_seconds()
    string automatic = seconds <= 60 ? "TIMING" : seconds <= 180 ? "REFINEMENT" : seconds <= 300 ? "ENTRY" : seconds <= 900 ? "SETUP" : seconds <= 1800 ? "INTRADAY" : seconds <= 3600 ? "INTERMEDIATE" : "MACRO"
    switch mode
        "Scalp" => seconds <= 180 ? "REFINEMENT" : "ENTRY"
        "Intraday" => seconds <= 900 ? "SETUP" : "INTRADAY"
        "Swing" => seconds <= 3600 ? "INTERMEDIATE" : "MACRO"
        => automatic

f_context_timeframes() =>
    float seconds = timeframe.in_seconds()
    string setupTf = seconds <= 60 ? "5" : seconds <= 300 ? "15" : seconds <= 900 ? "30" : seconds <= 1800 ? "60" : seconds <= 3600 ? "240" : "D"
    string macroTf = seconds <= 300 ? "60" : seconds <= 1800 ? "240" : seconds <= 14400 ? "D" : "W"
    [setupTf, macroTf]

f_trend_state(float price, float fast, float slow, float atrValue) =>
    float slope = fast - fast[3]
    float separation = f_safe_div(math.abs(fast - slow), atrValue)
    bool bullish = price > fast and fast > slow and slope > 0.0
    bool bearish = price < fast and fast < slow and slope < 0.0
    bullish ? (separation >= 0.45 ? 2 : 1) : bearish ? (separation >= 0.45 ? -2 : -1) : 0

f_trend_text(int state) =>
    state == 2 ? "STRONG UP" : state == 1 ? "UP" : state == -2 ? "STRONG DOWN" : state == -1 ? "DOWN" : "NEUTRAL"

f_conflict(int direction, int setupState, int macroState) =>
    bool setupOpposes = direction == 1 ? setupState < 0 : setupState > 0
    bool macroOpposes = direction == 1 ? macroState < 0 : macroState > 0
    bool strongSetupOpposes = direction == 1 ? setupState == -2 : setupState == 2
    bool strongMacroOpposes = direction == 1 ? macroState == -2 : macroState == 2
    strongSetupOpposes and strongMacroOpposes ? 4 : strongMacroOpposes ? 3 : setupOpposes and macroOpposes ? 2 : setupOpposes or macroOpposes ? 1 : 0

f_conflict_text(int severity) =>
    severity == 4 ? "CRITICAL" : severity == 3 ? "STRONG" : severity == 2 ? "MODERATE" : severity == 1 ? "MILD" : "NONE"

f_quality_threshold() =>
    strictness == "Conservative" ? 72.0 : strictness == "Aggressive" ? 57.0 : 64.0

f_price(float value) =>
    na(value) ? "—" : str.tostring(value, format.mintick)

// ─────────────────────────────────────────────────────────────────────────────
// Role-aware local indicators
// ─────────────────────────────────────────────────────────────────────────────
string role = f_role()
[setupTf, macroTf] = f_context_timeframes()

float fastTiming = ta.ema(close, 7)
float fastRefinement = ta.ema(close, 9)
float fastEntry = ta.ema(close, 12)
float fastSetup = ta.ema(close, 20)
float fastIntraday = ta.ema(close, 21)
float fastIntermediate = ta.ema(close, 24)
float fastMacro = ta.ema(close, 30)
float slowTiming = ta.ema(close, 18)
float slowRefinement = ta.ema(close, 21)
float slowEntry = ta.ema(close, 26)
float slowShared = ta.ema(close, 50)
float rsiTiming = ta.rsi(close, 7)
float rsiRefinement = ta.rsi(close, 9)
float rsiEntry = ta.rsi(close, 10)
float rsiShared = ta.rsi(close, 14)
float atrTiming = ta.atr(7)
float atrRefinement = ta.atr(9)
float atrEntry = ta.atr(10)
float atrShared = ta.atr(14)
float volumeTiming = ta.sma(volume, 12)
float volumeRefinement = ta.sma(volume, 16)
float volumeEntry = ta.sma(volume, 20)
float volumeSetup = ta.sma(volume, 24)
float volumeIntermediate = ta.sma(volume, 30)
float volumeMacro = ta.sma(volume, 36)

float fastEma = switch role
    "TIMING" => fastTiming
    "REFINEMENT" => fastRefinement
    "ENTRY" => fastEntry
    "SETUP" => fastSetup
    "INTRADAY" => fastIntraday
    "INTERMEDIATE" => fastIntermediate
    => fastMacro

float slowEma = switch role
    "TIMING" => slowTiming
    "REFINEMENT" => slowRefinement
    "ENTRY" => slowEntry
    => slowShared

float roleRsi = switch role
    "TIMING" => rsiTiming
    "REFINEMENT" => rsiRefinement
    "ENTRY" => rsiEntry
    => rsiShared

float roleAtr = switch role
    "TIMING" => atrTiming
    "REFINEMENT" => atrRefinement
    "ENTRY" => atrEntry
    => atrShared

float volumeAverage = switch role
    "TIMING" => volumeTiming
    "REFINEMENT" => volumeRefinement
    "ENTRY" => volumeEntry
    "SETUP" => volumeSetup
    "INTRADAY" => volumeSetup
    "INTERMEDIATE" => volumeIntermediate
    => volumeMacro

float relativeVolume = f_safe_div(volume, volumeAverage)
float atrPercent = f_safe_div(roleAtr, close) * 100.0
float rangeAverage = ta.sma(high - low, 20)
float rangeRatio = f_safe_div(high - low, rangeAverage)

// Strict previous-confirmed HTF values prevent realtime HTF drift.
float setupClose = request.security(syminfo.tickerid, setupTf, close[1], barmerge.gaps_off, barmerge.lookahead_on)
float setupFast = request.security(syminfo.tickerid, setupTf, ta.ema(close, 20)[1], barmerge.gaps_off, barmerge.lookahead_on)
float setupSlow = request.security(syminfo.tickerid, setupTf, ta.ema(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_on)
float setupAtr = request.security(syminfo.tickerid, setupTf, ta.atr(14)[1], barmerge.gaps_off, barmerge.lookahead_on)
float macroClose = request.security(syminfo.tickerid, macroTf, close[1], barmerge.gaps_off, barmerge.lookahead_on)
float macroFast = request.security(syminfo.tickerid, macroTf, ta.ema(close, 24)[1], barmerge.gaps_off, barmerge.lookahead_on)
float macroSlow = request.security(syminfo.tickerid, macroTf, ta.ema(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_on)
float macroAtr = request.security(syminfo.tickerid, macroTf, ta.atr(14)[1], barmerge.gaps_off, barmerge.lookahead_on)

int localTrend = f_trend_state(close, fastEma, slowEma, roleAtr)
int setupTrend = f_trend_state(setupClose, setupFast, setupSlow, setupAtr)
int macroTrend = f_trend_state(macroClose, macroFast, macroSlow, macroAtr)

// ─────────────────────────────────────────────────────────────────────────────
// Structure and regime
// ─────────────────────────────────────────────────────────────────────────────
float recentHigh = ta.highest(high[1], structureLookback)
float recentLow = ta.lowest(low[1], structureLookback)
float swingHigh = ta.highest(high[1], swingLookback)
float swingLow = ta.lowest(low[1], swingLookback)
float channelWidth = math.max(recentHigh - recentLow, syminfo.mintick)
float channelPosition = f_clamp(f_safe_div(close - recentLow, channelWidth), 0.0, 1.0)
float netMovement = math.abs(close - close[structureLookback])
float pathMovement = math.sum(math.abs(ta.change(close)), structureLookback)
float efficiency = f_safe_div(netMovement, pathMovement)
float bbBasis = ta.sma(close, 20)
float bbWidth = f_safe_div(ta.stdev(close, 20) * 4.0, bbBasis)
float bbWidthAverage = ta.sma(bbWidth, 50)
float atrPercentAverage = ta.sma(atrPercent, 50)
float channelAtrWidth = f_safe_div(channelWidth, roleAtr)
bool compression = bbWidth < bbWidthAverage * 0.72 and atrPercent < atrPercentAverage * 0.82
bool stableRange = efficiency < 0.28 and channelAtrWidth >= 2.5 and channelAtrWidth <= 9.0
bool chaotic = rangeRatio > 2.2 and relativeVolume < 0.9
bool breakoutUp = close > recentHigh and close[1] <= recentHigh and relativeVolume >= 1.10
bool breakoutDown = close < recentLow and close[1] >= recentLow and relativeVolume >= 1.10
bool failedBreakoutUp = high > recentHigh and close < recentHigh and close < open
bool failedBreakoutDown = low < recentLow and close > recentLow and close > open
string regime = chaotic ? "CHAOTIC" : compression ? "COMPRESSION" : breakoutUp ? "EXPANSION UP" : breakoutDown ? "EXPANSION DOWN" : failedBreakoutUp ? "FAILED BREAKOUT UP" : failedBreakoutDown ? "FAILED BREAKOUT DOWN" : stableRange ? "RANGE" : localTrend > 0 ? "TREND UP" : localTrend < 0 ? "TREND DOWN" : "TRANSITION"

// ─────────────────────────────────────────────────────────────────────────────
// Independent long and short candidates
// ─────────────────────────────────────────────────────────────────────────────
float lowerWick = math.min(open, close) - low
float upperWick = high - math.max(open, close)
float candleBody = math.max(math.abs(close - open), syminfo.mintick)
bool bullishRejection = close > open and lowerWick > candleBody * 0.8
bool bearishRejection = close < open and upperWick > candleBody * 0.8
float lastBreakoutUpLevel = ta.valuewhen(breakoutUp, recentHigh, 0)
float lastBreakoutDownLevel = ta.valuewhen(breakoutDown, recentLow, 0)
int barsSinceBreakoutUp = ta.barssince(breakoutUp)
int barsSinceBreakoutDown = ta.barssince(breakoutDown)

bool pullbackLong = setupTrend > 0 and low <= fastEma + roleAtr * 0.20 and close > fastEma and close > open
bool pullbackShort = setupTrend < 0 and high >= fastEma - roleAtr * 0.20 and close < fastEma and close < open
bool retestLong = setupTrend >= 0 and not na(lastBreakoutUpLevel) and barsSinceBreakoutUp >= 1 and barsSinceBreakoutUp <= 8 and low <= lastBreakoutUpLevel + roleAtr * 0.15 and close > lastBreakoutUpLevel and close > open
bool retestShort = setupTrend <= 0 and not na(lastBreakoutDownLevel) and barsSinceBreakoutDown >= 1 and barsSinceBreakoutDown <= 8 and high >= lastBreakoutDownLevel - roleAtr * 0.15 and close < lastBreakoutDownLevel and close < open
bool reclaimLong = failedBreakoutDown and bullishRejection
bool reclaimShort = failedBreakoutUp and bearishRejection
bool rangeLong = stableRange and channelPosition <= 0.20 and bullishRejection
bool rangeShort = stableRange and channelPosition >= 0.80 and bearishRejection

string longStrategy = pullbackLong ? "Trend Pullback" : retestLong ? "Breakout Retest" : reclaimLong ? "Failed Breakdown Reclaim" : rangeLong ? "Range Support Rejection" : "None"
string shortStrategy = pullbackShort ? "Trend Pullback" : retestShort ? "Breakdown Retest" : reclaimShort ? "Failed Breakout Rejection" : rangeShort ? "Range Resistance Rejection" : "None"
bool longRaw = longStrategy != "None"
bool shortRaw = shortStrategy != "None"

f_candidate_quality(int direction, string strategy) =>
    float structureScore = direction == 1 ? (channelPosition <= 0.35 ? 88.0 : channelPosition <= 0.60 ? 68.0 : 48.0) : (channelPosition >= 0.65 ? 88.0 : channelPosition >= 0.40 ? 68.0 : 48.0)
    float trendScore = direction == 1 ? (setupTrend > 0 ? 84.0 : setupTrend == 0 ? 58.0 : 28.0) : (setupTrend < 0 ? 84.0 : setupTrend == 0 ? 58.0 : 28.0)
    float participationScore = f_clamp(45.0 + (relativeVolume - 0.8) * 35.0, 25.0, 95.0)
    float momentumScore = direction == 1 ? f_clamp(50.0 + (roleRsi - 50.0) * 1.4, 20.0, 92.0) : f_clamp(50.0 + (50.0 - roleRsi) * 1.4, 20.0, 92.0)
    float strategyScore = strategy == "Trend Pullback" ? 82.0 : strategy == "Breakout Retest" or strategy == "Breakdown Retest" ? 80.0 : strategy == "Failed Breakdown Reclaim" or strategy == "Failed Breakout Rejection" ? 78.0 : strategy == "Range Support Rejection" or strategy == "Range Resistance Rejection" ? 74.0 : 0.0
    structureScore * 0.28 + trendScore * 0.24 + participationScore * 0.16 + momentumScore * 0.12 + strategyScore * 0.20

float longQuality = longRaw ? f_candidate_quality(1, longStrategy) : 0.0
float shortQuality = shortRaw ? f_candidate_quality(-1, shortStrategy) : 0.0
int longConflict = f_conflict(1, setupTrend, macroTrend)
int shortConflict = f_conflict(-1, setupTrend, macroTrend)
float longPenalty = longConflict == 4 ? 100.0 : longConflict == 3 ? 28.0 : longConflict == 2 ? 16.0 : longConflict == 1 ? 7.0 : 0.0
float shortPenalty = shortConflict == 4 ? 100.0 : shortConflict == 3 ? 28.0 : shortConflict == 2 ? 16.0 : shortConflict == 1 ? 7.0 : 0.0
longQuality -= longPenalty
shortQuality -= shortPenalty
float qualityThreshold = f_quality_threshold()
bool longValid = longRaw and longQuality >= qualityThreshold and longConflict < 4 and not chaotic
bool shortValid = shortRaw and shortQuality >= qualityThreshold and shortConflict < 4 and not chaotic
int direction = longValid and not shortValid ? 1 : shortValid and not longValid ? -1 : longValid and shortValid ? (longQuality > shortQuality + 4.0 ? 1 : shortQuality > longQuality + 4.0 ? -1 : 0) : 0
bool unresolvedConflict = longValid and shortValid and direction == 0
string selectedStrategy = direction == 1 ? longStrategy : direction == -1 ? shortStrategy : "None"
float selectedQuality = direction == 1 ? longQuality : direction == -1 ? shortQuality : 0.0
int selectedConflict = direction == 1 ? longConflict : direction == -1 ? shortConflict : 0

// ─────────────────────────────────────────────────────────────────────────────
// Entry, stop, and targets
// ─────────────────────────────────────────────────────────────────────────────
float entryLow = na
float entryHigh = na
float idealEntry = na
float stopPrice = na
float tp1 = na
float tp2 = na
float tp3 = na
float maximumChase = na
float riskDistance = na
float tp1RR = na

if direction == 1
    float reference = selectedStrategy == "Trend Pullback" ? fastEma : selectedStrategy == "Breakout Retest" ? lastBreakoutUpLevel : selectedStrategy == "Failed Breakdown Reclaim" ? recentLow : recentLow + channelWidth * 0.08
    entryLow := reference - roleAtr * 0.12
    entryHigh := reference + roleAtr * 0.18
    idealEntry := reference
    stopPrice := math.min(swingLow, recentLow) - roleAtr * stopAtrBuffer
    riskDistance := idealEntry - stopPrice
    maximumChase := idealEntry + roleAtr * maximumChaseAtr
    float structuralTarget = math.min(recentHigh, idealEntry + riskDistance * 1.5)
    tp1 := structuralTarget > idealEntry ? structuralTarget : idealEntry + riskDistance * 1.25
    tp2 := idealEntry + riskDistance * tp2Multiple
    tp3 := idealEntry + riskDistance * tp3Multiple
    tp1RR := f_safe_div(tp1 - idealEntry, riskDistance)

if direction == -1
    float reference = selectedStrategy == "Trend Pullback" ? fastEma : selectedStrategy == "Breakdown Retest" ? lastBreakoutDownLevel : selectedStrategy == "Failed Breakout Rejection" ? recentHigh : recentHigh - channelWidth * 0.08
    entryLow := reference - roleAtr * 0.18
    entryHigh := reference + roleAtr * 0.12
    idealEntry := reference
    stopPrice := math.max(swingHigh, recentHigh) + roleAtr * stopAtrBuffer
    riskDistance := stopPrice - idealEntry
    maximumChase := idealEntry - roleAtr * maximumChaseAtr
    float structuralTarget = math.max(recentLow, idealEntry - riskDistance * 1.5)
    tp1 := structuralTarget < idealEntry ? structuralTarget : idealEntry - riskDistance * 1.25
    tp2 := idealEntry - riskDistance * tp2Multiple
    tp3 := idealEntry - riskDistance * tp3Multiple
    tp1RR := f_safe_div(idealEntry - tp1, riskDistance)

bool geometryValid = direction != 0 and not na(riskDistance) and riskDistance > syminfo.mintick * 2.0 and tp1RR >= minimumTp1RR
bool inEntryZone = geometryValid and close >= entryLow and close <= entryHigh
bool chased = direction == 1 ? close > maximumChase : direction == -1 ? close < maximumChase : false
bool triggerConfirmed = direction == 1 ? close > open and close > idealEntry : direction == -1 ? close < open and close < idealEntry : false
bool barConfirmed = not confirmOnClose or barstate.isconfirmed
string entryState = direction == 0 ? "NO TRADE" : not geometryValid ? "INVALID GEOMETRY" : chased ? "LATE / CHASED" : inEntryZone and triggerConfirmed and barConfirmed ? "READY NOW" : inEntryZone ? "CONFIRMATION" : direction == 1 and close < entryLow ? "APPROACHING ENTRY" : direction == -1 and close > entryHigh ? "APPROACHING ENTRY" : "PULLBACK / RETEST PENDING"
bool readyLong = direction == 1 and geometryValid and not chased and inEntryZone and triggerConfirmed and barConfirmed
bool readyShort = direction == -1 and geometryValid and not chased and inEntryZone and triggerConfirmed and barConfirmed
bool activePlan = direction != 0 and geometryValid and not chased
bool runnerAllowed = selectedConflict <= 1 and (direction == 1 ? setupTrend > 0 : direction == -1 ? setupTrend < 0 : false)

// ─────────────────────────────────────────────────────────────────────────────
// Display
// ─────────────────────────────────────────────────────────────────────────────
plot(fastEma, "Role EMA Fast", color=color.new(entryColour, 10), linewidth=1)
plot(slowEma, "Role EMA Slow", color=color.new(neutralColour, 25), linewidth=2)
color regimeBackground = regime == "TREND UP" or regime == "EXPANSION UP" ? color.new(longColour, 92) : regime == "TREND DOWN" or regime == "EXPANSION DOWN" ? color.new(shortColour, 92) : regime == "COMPRESSION" ? color.new(entryColour, 92) : regime == "CHAOTIC" ? color.new(color.orange, 90) : color.new(neutralColour, 94)
bgcolor(showRegimeBackground ? regimeBackground : na)

var box entryBox = na
var line entryLine = na
var line stopLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var line chaseLine = na
var label setupLabel = na

if barstate.islast
    box.delete(entryBox)
    line.delete(entryLine)
    line.delete(stopLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    line.delete(chaseLine)
    label.delete(setupLabel)
    if showGeometry and activePlan
        color directionColour = direction == 1 ? longColour : shortColour
        entryBox := box.new(bar_index - 1, entryHigh, bar_index + 12, entryLow, border_color=color.new(entryColour, 10), bgcolor=color.new(entryColour, 86))
        entryLine := line.new(bar_index - 1, idealEntry, bar_index + 12, idealEntry, color=entryColour, width=2)
        stopLine := line.new(bar_index - 1, stopPrice, bar_index + 12, stopPrice, color=shortColour, width=2)
        tp1Line := line.new(bar_index - 1, tp1, bar_index + 12, tp1, color=longColour, width=2)
        tp2Line := line.new(bar_index - 1, tp2, bar_index + 12, tp2, color=color.new(longColour, 20), width=1)
        if runnerAllowed
            tp3Line := line.new(bar_index - 1, tp3, bar_index + 12, tp3, color=color.new(longColour, 40), width=1, style=line.style_dashed)
        chaseLine := line.new(bar_index - 1, maximumChase, bar_index + 12, maximumChase, color=color.new(entryColour, 30), width=1, style=line.style_dotted)
        setupLabel := label.new(bar_index, direction == 1 ? low : high, "APEX " + (direction == 1 ? "LONG" : "SHORT") + "\n" + selectedStrategy + "\n" + entryState + " • Q " + str.tostring(math.round(selectedQuality)), style=direction == 1 ? label.style_label_up : label.style_label_down, color=directionColour, textcolor=color.white)

bool newReadyLong = readyLong and not readyLong[1]
bool newReadyShort = readyShort and not readyShort[1]
plotshape(newReadyLong, title="Apex Long Ready", style=shape.triangleup, location=location.belowbar, color=longColour, size=size.small, text="APEX L")
plotshape(newReadyShort, title="Apex Short Ready", style=shape.triangledown, location=location.abovebar, color=shortColour, size=size.small, text="APEX S")

var table dashboard = table.new(position.top_right, 2, 16, border_width=1)
f_cell(int row, string key, string value, color valueColour) =>
    table.cell(dashboard, 0, row, key, text_color=color.new(color.white, 20), bgcolor=color.new(color.black, 25), text_size=size.small)
    table.cell(dashboard, 1, row, value, text_color=valueColour, bgcolor=color.new(color.black, 25), text_size=size.small)

if barstate.islast
    table.clear(dashboard, 0, 0, 1, 15)
    if showDashboard
        color directionTextColour = direction == 1 ? longColour : direction == -1 ? shortColour : neutralColour
        table.cell(dashboard, 0, 0, "APEX PRECISION", text_color=color.white, bgcolor=color.new(directionTextColour, 35), text_size=size.small)
        table.cell(dashboard, 1, 0, role, text_color=color.white, bgcolor=color.new(directionTextColour, 35), text_size=size.small)
        f_cell(1, "Regime", regime, regime == "TREND UP" or regime == "EXPANSION UP" ? longColour : regime == "TREND DOWN" or regime == "EXPANSION DOWN" ? shortColour : neutralColour)
        f_cell(2, "Direction", unresolvedConflict ? "CONFLICT" : direction == 1 ? "LONG" : direction == -1 ? "SHORT" : "NO TRADE", directionTextColour)
        f_cell(3, "Strategy", selectedStrategy, color.white)
        f_cell(4, "Status", entryState, entryState == "READY NOW" ? longColour : entryColour)
        f_cell(5, "HTF conflict", f_conflict_text(selectedConflict), selectedConflict >= 3 ? shortColour : selectedConflict >= 1 ? entryColour : longColour)
        f_cell(6, "Entry", f_price(idealEntry), entryColour)
        f_cell(7, "Stop", f_price(stopPrice), shortColour)
        f_cell(8, "TP1", f_price(tp1), longColour)
        f_cell(9, "TP2", f_price(tp2), longColour)
        f_cell(10, "TP3", runnerAllowed ? f_price(tp3) : "Disabled", runnerAllowed ? longColour : neutralColour)
        f_cell(11, "Quality", direction == 0 ? "—" : str.tostring(math.round(selectedQuality)) + "/100", directionTextColour)
        if showDebug
            f_cell(12, "Local trend", f_trend_text(localTrend), color.white)
            f_cell(13, "Setup " + setupTf, f_trend_text(setupTrend), color.white)
            f_cell(14, "Macro " + macroTf, f_trend_text(macroTrend), color.white)
            f_cell(15, "RVOL / RSI", str.tostring(relativeVolume, "#.##") + " / " + str.tostring(roleRsi, "#.0"), color.white)

// ─────────────────────────────────────────────────────────────────────────────
// Alerts
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(newReadyLong, "APEX LONG READY", "APEX LONG READY | {{ticker}} | TF {{interval}} | Closed-candle confirmed")
alertcondition(newReadyShort, "APEX SHORT READY", "APEX SHORT READY | {{ticker}} | TF {{interval}} | Closed-candle confirmed")
alertcondition(activePlan and entryState == "APPROACHING ENTRY", "APEX APPROACHING ENTRY", "APEX APPROACHING ENTRY | {{ticker}} | TF {{interval}}")
alertcondition(direction == 0 and unresolvedConflict, "APEX DIRECTION CONFLICT", "APEX DIRECTION CONFLICT | {{ticker}} | TF {{interval}}")
